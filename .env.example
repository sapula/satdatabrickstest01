# Databricks Configuration
# Copy this file to .env and fill in your values

# Databricks workspace URL (e.g., https://your-workspace.cloud.databricks.com)
DATABRICKS_HOST=

# Databricks personal access token or service principal token
DATABRICKS_TOKEN=

# Service principal ID for prod deployments (optional for dev)
DATABRICKS_SERVICE_PRINCIPAL_ID=

# Notification email
NOTIFICATION_EMAIL=your-email@example.com

# Catalog names
CATALOG_DEV=tpccopy001_dev
CATALOG_STAGING=tpccopy001_staging
CATALOG_PROD=tpccopy001

# Schema name
SCHEMA=poc
